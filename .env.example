# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave publicável (sb_publishable_...) ou a antiga "anon"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secreta (sb_secret_...) ou a antiga "service_role". NUNCA exponha no browser.
SUPABASE_SECRET_KEY=

# Domínio público usado nos links das TAGs e QR Codes (sem barra no final).
# Na Vercel, se vazio, usa o domínio de produção do projeto.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Texto aleatório para anonimizar IPs (gere com: openssl rand -hex 32).
# Não altere depois de entrar em produção, senão a contagem de únicos reinicia.
IP_HASH_SALT=

# Contato exibido na landing (botões "Quero meu cartão").
# WhatsApp com DDI + DDD, só números. Se vazio, usa o e-mail.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_INSTAGRAM=

# Google Places API (New): opcional. Habilita a busca do negócio no quiz /comecar
# e na ativação dos cartões. Sem ela, os formulários pedem nome e cidade.
GOOGLE_PLACES_API_KEY=

# Apify: scraper do Google Maps (nota, avaliações, fotos, horário, respostas do dono).
# Fonte das métricas do painel, da página Evolução e do cron semanal.
# Apify Console → Settings → API & Integrations → Personal API tokens.
APIFY_TOKEN=
# Opcional: Actor usado (padrão: compass~crawler-google-places).
APIFY_MAPS_ACTOR=

# OpenAI: análise do perfil no Google Maps (painel do negócio e ativação dos cartões).
# Somente no servidor. Sem ela, o painel mostra só o checklist automático.
OPENAI_API_KEY=
# Opcional: modelo usado na análise (padrão: gpt-5-mini).
OPENAI_MODEL=

# Segredo do cron semanal (/api/cron/google). Na Vercel, a mesma variável é
# enviada automaticamente no cabeçalho Authorization (gere com: openssl rand -hex 32).
CRON_SECRET=
